{
  "dispositivos": {
    "apps": [
      "dispositivos",
      "datacalle"
    ],
    "url_prefixes": [
      "dispositivos/",
      "datacalle/",
      "api/datacalle/"
    ],
    "urlconf": "dispositivos_runtime.urls",
    "origin_env": "BACKEND_DISPOSITIVOS_ORIGIN",
    "default_origin": "http://backend_dispositivos:8000",
    "service": "backend_dispositivos",
    "migrate_service": "migrator",
    "favorite_sections": [
      "dispositivos"
    ]
  },
  "vpsl": {
    "apps": [
      "ver_para_ser_libre"
    ],
    "url_prefixes": [
      "ver-para-ser-libre/",
      "api/vpsl/"
    ],
    "urlconf": "vpsl_runtime.urls",
    "origin_env": "BACKEND_VPSL_ORIGIN",
    "default_origin": "http://backend_vpsl:8000",
    "service": "backend_vpsl",
    "migrate_service": "migrator"
  },
  "pas": {
    "apps": [
      "pas"
    ],
    "url_prefixes": [
      "pas/",
      "media/pas/"
    ],
    "urlconf": "pas_runtime.urls",
    "origin_env": "BACKEND_PAS_ORIGIN",
    "default_origin": "http://backend_pas:8000",
    "service": "backend_pas",
    "migrate_service": "migrator",
