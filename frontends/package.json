{
  "name": "@sisoc/frontends",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:celiaquia": "npm run dev --workspace @sisoc/celiaquia",
    "api:types": "openapi-typescript packages/api/openapi.yaml -o packages/api/src/openapi.d.ts",
    "api:check": "node scripts/verificar-contrato.mjs",
    "api:schema": "echo \"Correr desde la raiz del repo: docker compose exec django python manage.py spectacular --urlconf config.urls_frontend_v2 --file frontends/packages/api/openapi.yaml\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
